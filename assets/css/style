:root{--bg:#f7f7f5;--surface:#fff;--text:#151515;--muted:#666;--border:#deded8;--soft:#eeeeea;--max:1160px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6}body.modal-open{overflow:hidden}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.container{width:min(calc(100% - 40px),var(--max));margin:auto}.site-header{position:sticky;top:0;z-index:100;background:rgba(247,247,245,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}.nav-wrap{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.03em}.brand-mark{width:38px;height:38px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px;background:#151515;color:#fff;font-size:12px}.main-nav{display:flex;gap:22px}.main-nav a{font-size:14px;font-weight:650;color:#555}.main-nav a:hover,.main-nav a.active{color:#111}.menu-toggle{display:none;border:0;background:transparent;font-size:25px;cursor:pointer}.hero{padding:95px 0 75px}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:65px;align-items:center}.eyebrow,.mini-label,.card-label,.tool-tag{font-size:10px;font-weight:800;letter-spacing:.14em;color:#777}.eyebrow{display:inline-block;margin-bottom:12px}h1,h2,h3,h4{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(44px,7vw,76px);margin:0 0 22px}h2{font-size:clamp(29px,4vw,42px);margin:0 0 14px}h3{font-size:22px;margin:8px 0 10px}p{color:var(--muted)}.lead{font-size:19px;max-width:650px}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border-radius:10px;border:1px solid #151515;font-weight:750;cursor:pointer}.btn-primary{background:#151515;color:#fff}.btn-secondary{background:transparent}.snapshot,.card,.tool-card,.kit-card,.info-card,.form-card{background:var(--surface);border:1px solid var(--border);border-radius:18px}.snapshot{padding:30px}.snapshot-top{display:flex;justify-content:space-between;gap:15px}.pill{display:inline-block;padding:5px 9px;border-radius:99px;background:var(--soft);font-size:10px;font-weight:800;text-transform:uppercase}.metric{font-size:48px;font-weight:850;letter-spacing:-.05em;margin:25px 0}.metric small{font-size:15px;font-weight:600;color:#777}.metric-list>div,.snapshot-total{display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid var(--border)}.section{padding:80px 0}.section-header{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.search-box{margin-bottom:25px}.search-box input{width:100%;padding:15px 17px;border:1px solid var(--border);border-radius:11px;background:#fff;outline:0}.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{padding:25px}.card-icon{width:38px;height:38px;border-radius:10px;background:var(--soft);display:flex;align-items:center;justify-content:center;font-weight:800;margin-bottom:18px}.card-link{font-weight:750}.kit-banner{padding:38px;border-radius:20px;background:#151515;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:30px}.kit-banner p{color:#bbb;max-width:600px}.page-hero{padding:75px 0 60px;border-bottom:1px solid var(--border)}.page-hero p{max-width:720px;font-size:19px}.kit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.kit-card{padding:28px}.price{display:block;font-size:30px;font-weight:850;margin-bottom:15px}.kit-card li{color:var(--muted);margin:5px 0}.three-up{display:grid;grid-template-columns:repeat(3,1fr);gap:35px}.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px}.info-card,.form-card{padding:28px;margin-top:18px}.form-card form{display:grid;gap:10px}.form-card label{font-size:14px;font-weight:750;margin-top:8px}.form-card input,.form-card select,.form-card textarea{width:100%;padding:13px 14px;border:1px solid var(--border);border-radius:10px;background:#fff;outline:0}.form-card textarea{resize:vertical}.narrow{max-width:820px}.legal-content h2{margin-top:38px}.site-footer{padding:55px 0 25px;border-top:1px solid var(--border)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px}.footer-grid>div{display:flex;flex-direction:column;gap:8px}.footer-bottom{margin-top:40px;padding-top:20px;border-top:1px solid var(--border);font-size:13px;color:#777}.donation-overlay{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.6);opacity:0;visibility:hidden;transition:.25s}.donation-overlay.is-visible{opacity:1;visibility:visible}.donation-modal{position:relative;width:min(100%,500px);padding:36px;border-radius:22px;background:#fff;box-shadow:0 25px 80px rgba(0,0,0,.25);transform:translateY(15px) scale(.98);transition:.25s}.donation-overlay.is-visible .donation-modal{transform:none}.donation-close{position:absolute;top:12px;right:15px;border:0;background:transparent;font-size:28px;cursor:pointer}.donation-actions{display:grid;gap:10px;margin-top:24px}.donation-button{width:100%}.donation-later{border:0;background:transparent;padding:8px;cursor:pointer;color:#666}.donation-note{text-align:center;font-size:12px}@media(max-width:900px){.hero-grid,.contact-grid{grid-template-columns:1fr}.card-grid,.kit-grid{grid-template-columns:repeat(2,1fr)}.three-up{grid-template-columns:1fr}}@media(max-width:700px){.container{width:min(calc(100% - 28px),var(--max))}.menu-toggle{display:block}.main-nav{position:absolute;left:14px;right:14px;top:66px;display:none;flex-direction:column;padding:15px;background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 15px 40px rgba(0,0,0,.1)}.main-nav.open{display:flex}.main-nav a{padding:8px}.hero{padding:65px 0 50px}.section{padding:60px 0}.section-header{align-items:start;flex-direction:column}.card-grid,.kit-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.kit-banner{align-items:flex-start;flex-direction:column}}@media(max-width:480px){h1{font-size:43px}.footer-grid{grid-template-columns:1fr}.actions .btn{width:100%}.donation-modal{padding:30px 24px 24px}}
